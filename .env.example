# Copy to api/.env (or export). Secrets never go in the database.
TACIT_ORG_NAME=Northwind Labs
TACIT_HANDLE=tacit
TACIT_SECRET_KEY=change-me-to-a-long-random-string
TACIT_DATABASE_URL=sqlite:///./tacit.db        # or postgresql+psycopg://user:pass@host/tacit
TACIT_HOST=127.0.0.1
TACIT_PORT=4800

# Brain: auto | anthropic | claude-cli | openai-compatible | local
TACIT_BRAIN_PROVIDER=auto
TACIT_BRAIN_MODEL=claude-opus-5
TACIT_BRAIN_EFFORT=medium
TACIT_ANTHROPIC_API_KEY=
# TACIT_BRAIN_BASE_URL=https://api.groq.com/openai/v1

# Connectors (polling — no public URL needed)
TACIT_GITHUB_TOKEN=            # or leave empty to use `gh auth token`
TACIT_GITHUB_REPOS=owner/repo,owner/other
TACIT_GITHUB_WEBHOOK_SECRET=
TACIT_SLACK_BOT_TOKEN=
TACIT_SLACK_CHANNELS=C0123ABC,C0456DEF
TACIT_SLACK_SIGNING_SECRET=
TACIT_LINEAR_API_KEY=
# TACIT_MCP_SERVERS=[{"name":"fs","command":["npx","-y","@modelcontextprotocol/server-filesystem","."]}]

# Trust ladder
TACIT_SHADOW_WINDOW_MINUTES=240
TACIT_GRADUATE_MIN_SCORED=10
TACIT_GRADUATE_MIN_TRUST=0.60
